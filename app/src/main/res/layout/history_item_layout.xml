<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="300dp"
    android:layout_height="300dp"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/history_item_outline_shape"
    android:layout_marginTop="30dp"
    android:id="@+id/history_item_layout">

    <Button
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:background="@drawable/btn_shape"
        style="@style/normalTextLight"
        android:textSize="24sp"
        android:textStyle="bold"
        android:id="@+id/history_item_date_btn"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        >
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="18dp"
            app:shapeAppearanceOverlay="@style/HistoryImageViewCorner"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:id="@+id/history_item_image_1"
            />
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:shapeAppearanceOverlay="@style/HistoryImageViewCorner"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:id="@+id/history_item_image_2"
            />
    </LinearLayout>

</LinearLayout>