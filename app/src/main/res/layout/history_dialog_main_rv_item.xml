<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="25dp"
    android:layout_marginHorizontal="30dp"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        >
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            app:shapeAppearanceOverlay="@style/GroundImageViewCorner"
            android:id="@+id/history_dialog_photo_iv"
            />
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignEnd="@id/history_dialog_photo_iv"
            android:scaleType="center"
            android:src="@drawable/fav_heart_unselected"
            android:background="#00F5EDDE"
            android:id="@+id/history_dialog_fav_ib"
            />
<!--       background transparent?? might be a problem -->
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:id="@+id/history_dialog_trigger_rv"
        />


</LinearLayout>